{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "chrome",
        "request": "launch",
        "name": "Launch Chrome (Debug)",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder}",
        "sourceMaps": true,
        "sourceMapPathOverrides": {
          "webpack:///src/*": "${webRoot}/src/*"
        },
        "runtimeArgs": ["--disable-web-security"]
      },
      {
        "type": "chrome",
        "request": "attach",
        "name": "Attach to Edge",
        "port": 9222,
        "webRoot": "${workspaceFolder}",
        "sourceMaps": true
      }
    ]
  }
  