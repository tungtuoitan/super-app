{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "start",
			"label": "npm: start",
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Compiling...",
					"endsPattern": "(Compiled successfully!|Failed to compile.)"
				}
			}
		},
		{
			"label": "sqlproj: Build SuperApp-dev",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"c:/Users/Admin/source/SuperApp/SuperApp-dev/SuperApp-dev.sqlproj"
			],
			"problemMatcher": "$sqlproj-problem-matcher",
			"isBackground": true,
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Builds the SuperApp-dev SQL project"
		}
	]
}