{
    "compilerOptions": {
        // "ignoreDeprecations": "6.0",
        "target": "es2015",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "esnext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "baseUrl": "src",
        "paths": {
            "@/config/*": ["utils/config/*"],
            "@/services/*": ["services/*"],
            "@/contexts/*": ["contexts/*"],
            "@/types/*": ["types/*"],
            "@/utils/*": ["utils/*"],
            "@/shared": ["shared/index"],
            "@/shared/*": ["shared/*"],
            "@/shell": ["shell/index"],
            "@/shell/*": ["shell/*"],
            "@/lib/*": ["lib/*"],
            "@/features/*": ["features/*"],
            "@/pages/*": ["pages/*"],
            "@/store/*": ["store/*"],
            "@/styles/*": ["styles/*"],
            "@/HeadlessComponents/*": ["HeadlessComponents/*"],
            "@/Selectors/*": ["Selectors/*"]
        }
    },
    "include": ["src"]
}
