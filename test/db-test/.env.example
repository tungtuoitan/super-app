# Copy values from loadtest/.env. db-test inherits DB_SERVER/USER/PASSWORD from there.
# These are db-test specific:

TEST_DB_NAME=SuperApp-test

# Path on the SQL Server host (Linux container in this case).
# Must be writable by the mssql process. /var/opt/mssql/data/ is the default and works.
TEST_DB_BACKUP_PATH=/var/opt/mssql/data/SuperApp-test.bak
