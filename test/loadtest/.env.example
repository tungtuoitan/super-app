# Copy to .env and fill in. .env is gitignored.

# === DB qua SSH tunnel 127.0.0.1:14330 (như Timeline/.env); secret = tham chiếu tung-vault, run.ps1 tự chạy trong secret run ===
DB_SERVER=127.0.0.1
DB_PORT=14330
DB_NAME=SuperApp-dev
DB_USER=sa
DB_PASSWORD=vault://vps/sql_server.sa_password

# === Load test users ===
LOADTEST_USER_COUNT=1000
LOADTEST_EMAIL_PREFIX=loadtest+
LOADTEST_EMAIL_DOMAIN=test.local
LOADTEST_PASSWORD=LoadTest@123

# === Target API ===
LOADTEST_BASE_URL=http://localhost:5000
