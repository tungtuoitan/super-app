# API Configuration
# IMPORTANT: In React CRA, use REACT_APP_ prefix for custom variables to be available in build
REACT_APP_LOCAL_API_URL=http://localhost:5000
REACT_APP_PRO_API_URL=http://157.66.101.51:5000

LOCAL_FE_URL=http://localhost:3000
PRO_FE_URL=http://157.66.101.51:3000

ENVIRONMENT=development
# Port Configuration
PORT=3000

# Browser Configuration
BROWSER=none

# Enable Fast Refresh (Hot Module Replacement)
FAST_REFRESH=true

# Disable source maps to prevent source-map-loader errors
GENERATE_SOURCEMAP=false

# Skip source map processing warnings
SKIP_PREFLIGHT_CHECK=true