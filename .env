# API Configuration
REACT_APP_API_URL=http://localhost:5000

# Port Configuration
PORT=3000

# Browser Configuration
BROWSER=none

# Enable Fast Refresh (Hot Module Replacement)
FAST_REFRESH=true

# Disable source maps to prevent source-map-loader errors
GENERATE_SOURCEMAP=false

# Skip source map processing warnings
SKIP_PREFLIGHT_CHECK=true
